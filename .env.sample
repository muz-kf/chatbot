OPENROUTER_API_KEY=openrouter-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MULTIMODAL_MODEL=google/gemini-2.5-flash
# For running locally on host with Docker db:
PSQL_STR=postgresql://postgres:postgres@localhost:5432/dazz
# For running in Docker Compose, the server container uses:
# PSQL_STR=postgresql://postgres:postgres@db:5432/dazz
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ENV=development
APP_ORIGIN=http://localhost:5001
PORT=5002
TRUSTED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:5002,http://127.0.0.1:5002

# Tool & Real-Time Search Configuration
# If ENABLE_TAVILY is true and TAVILY_API_KEY is set, search uses Tavily. Otherwise DuckDuckGo is used.
ENABLE_TAVILY=false
TAVILY_API_KEY=
# Optional system timezone override (e.g. UTC, America/New_York, Asia/Kolkata). Defaults to system local.
DEFAULT_TIMEZONE=Asia/Kolkata
